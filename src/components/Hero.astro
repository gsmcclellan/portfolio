---
---

<section class="hero">
  <p class="eyebrow">Hello, I'm</p>
  <h1>Greg McClellan</h1>
  <p class="tagline">
    Senior full-stack engineer with 10+ years building and owning production
    financial web applications. I design data models, APIs, and the long-lived
    architecture behind them — and I enjoy the kind of complex problems that
    only get harder as systems grow.
  </p>
  <div class="cta-row">
    <a href="#work" class="btn-primary">View my work</a>
    <a href="#contact" class="btn-secondary">Get in touch</a>
  </div>
</section>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6rem 1.5rem 5rem;
  }

  .eyebrow {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 520px;
    margin-bottom: 2rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    text-decoration: none;
    color: #fff;
  }

  .btn-secondary {
    display: inline-block;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .btn-secondary:hover {
    border-color: #aaa;
    text-decoration: none;
    color: var(--color-text);
  }
</style>
