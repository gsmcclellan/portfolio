    text-decoration: none;
  }

  .nav-logo:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  ul a {
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  ul a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    ul {
      gap: 1.25rem;
    }
  }
