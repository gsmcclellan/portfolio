---
const skillGroups = [
  {
    category: 'Languages',
    skills: ['JavaScript', 'TypeScript', 'Python', 'C#', 'HTML', 'CSS/SASS'],
  },
  {
    category: 'Frontend',
    skills: ['React', 'Angular', 'Polymer', 'Aurelia', 'Ag Grid', 'Kendo UI', 'Handsontable'],
  },
  {
    category: 'Backend & APIs',
    skills: [
      'Node.js',
        '.NET',
      'REST APIs',
      'GraphQL',
      'Google Cloud Functions',
      'Entity Framework',
    ],
  },
  {
    category: 'Cloud & Infra',
    skills: [
      'GCP (Cloud Functions, Firestore, Pub/Sub, Cloud Run/GKE)',
      'Azure',
      'Docker',
      'CI/CD pipelines',
    ],
  },
  {
    category: 'Databases',
    skills: ['Firestore', 'Firebase Realtime DB', 'SQL'],
  },
  {
    category: 'Testing',
    skills: ['Jest', 'MSTest'],
  },
];
---

<section id="skills">
  <div class="inner">
    <h2>Skills</h2>
    <div class="skill-groups">
      {
        skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.category}</h3>
            <ul>
              {group.skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--color-border);
    padding: var(--section-gap) 0;
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    padding-top: 0.25rem;
  }

  .skill-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .skill-group h3 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  li {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .skill-groups {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 380px) {
    .skill-groups {
      grid-template-columns: 1fr;
    }
  }
</style>
